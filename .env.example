# ===================================
# Task Manager API Environment Configuration
# ===================================

# Database Configuration
# Replace with your PostgreSQL connection string
DB_URL="postgres://username:password@localhost:5432/taskmanager?sslmode=disable"

# JWT Configuration
# Generate a strong secret key for JWT token signing
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT="8080"
BASE_URL="http://localhost:8080"

# ===================================
# Email Configuration (Optional)
# ===================================
# For development: Leave these empty to use console logging
# For production: Configure SMTP settings for real email delivery

# SMTP Server Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Email Credentials
# For Gmail: Use app-specific password instead of regular password
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_USERNAME=""
SMTP_PASSWORD=""

# From Email Address
FROM_EMAIL="noreply@yourdomain.com"

# ===================================
# Development Notes
# ===================================
# 1. Without SMTP configuration, emails will be logged to console
# 2. Make sure to create the PostgreSQL database before starting
# 3. The application will auto-migrate database tables on startup
# 4. For production, use environment variables instead of .env file

# ===================================
# OAuth Configuration (Optional)
# ===================================

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:8080/api/auth/google/callback"

# ===================================
# OAuth Setup Instructions
# ===================================
# Google OAuth Setup:
# 1. Go to https://console.developers.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URI: http://localhost:8080/api/auth/google/callback
# 6. Copy Client ID and Client Secret to above variables
